# Copie este arquivo para ".env" e preencha. O .env guarda senha: não compartilhe nem versione.

# ===== CASI =====
CASI_URL=http://192.168.57.78:8080/casi
CASI_USUARIO=
CASI_SENHA=

# ===== Entrada =====
# CSV exportado da lista de chamados do GLPI (colunas ID, Categoria, Status e Descrição).
# A cada execução os chamados XCash novos dele entram na planilha. Deixe vazio para não usar.
CSV_GLPI=glpi.csv
# Planilha onde ficam os chamados e os resultados (caminho relativo a esta pasta ou absoluto)
PLANILHA=chamados.xlsx

# ===== Categorias atendidas =====
# Linhas de outra categoria ficam como IGNORADO (e não são importadas do CSV).
EXIGIR_CATEGORIA=true
CATEGORIA_ID=2314030
CATEGORIA_RESET=Tecnologia > Operações de TI > Sistemas > Acessos/Liberações > Acesso ao Sistema XCash (Tesouraria loja) > Reset de senha
CATEGORIA_CRIACAO=Tecnologia > Operações de TI > Sistemas > Acessos/Liberações > Acesso ao Sistema XCash (Tesouraria loja) > Criação de usuário XCash
# ID da categoria de criação no GLPI (opcional; só se a planilha usar o número em vez do caminho)
CATEGORIA_CRIACAO_ID=
# Chamado de Criação cujo usuário JÁ existe no CASI:
#   resetar = reseta a senha e gera a mensagem de acesso, igual ao Reset de senha
#   revisao = deixa para tratamento manual
# Se o usuário não existe, sempre vai para REVISÃO MANUAL (a automação não cria usuários).
CRIACAO_SE_JA_EXISTE=resetar

# ===== Senha =====
# Caracteres usados entre "Dpsp" e a matrícula, na ordem de tentativa. Quando o CASI responde
# "Senha já utilizada anteriormente", a automação tenta o próximo: Dpsp@ -> Dpsp! -> Dpsp# -> ...
# Mantenha entre aspas simples. A coluna "Caractere senha" da planilha substitui esta lista para a linha.
CARACTERES_SENHA='@!#$&*'

# ===== Resposta no GLPI (web) =====
GLPI_URL=https://suporte.dpsp.io
# RESPONDER_GLPI=false: só reseta no CASI e deixa a mensagem pronta (você responde o chamado na mão).
# RESPONDER_GLPI=true: a automação abre o chamado e escreve a solução.
RESPONDER_GLPI=false
# Trava de segurança. Mesmo com RESPONDER_GLPI=true, enquanto GLPI_SUBMETER=false a automação
# PREENCHE a solução mas NÃO clica em Adicionar. Deixe false até validar que a tela está certa.
GLPI_SUBMETER=false
# Status marcado na solução
GLPI_STATUS_SOLUCAO=Solucionado
# Navegador do GLPI (chrome, msedge ou chromium) e pasta do perfil que guarda o login entre execuções.
# Você loga uma vez com "python main.py --login-glpi" e nas próximas vezes já abre logado (inclusive SSO).
GLPI_NAVEGADOR=chrome
GLPI_PERFIL=perfil_glpi

# ===== Execução =====
# msedge, chrome ou chromium (chromium exige "python -m playwright install chromium"); no GitLab use chromium
NAVEGADOR=msedge
HEADLESS=true
TIMEOUT_SEGUNDOS=30
# Pausa, em segundos, entre um chamado e outro (para não sobrecarregar o GLPI/CASI)
PAUSA_ENTRE_CHAMADOS=5
